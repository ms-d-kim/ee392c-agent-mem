# Generated trace and profile artifacts.
# traces/*.jsonl only matches scratch runs directly in traces/ (gitignore *
# does not cross /), so the official traces/final_v3*/ datasets stay tracked.
# The two legacy hello_bug_run traces predate the rule and stay tracked.
traces/*.jsonl
!traces/hello_bug_run1.jsonl
!traces/hello_bug_run2.jsonl
traces/*.parquet
traces/*.nsys-rep
traces/*.sqlite
analysis_out/**/*.nsys-rep
analysis_out/**/*.sqlite

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.env
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Adversarial ping-pong review outputs (driver script reviews/pingpong/run.sh stays tracked)
reviews/pingpong/round_*.md
reviews/pingpong/run.log
